          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Energy type, e.g. Fire (see /types)",
              "title": "Type"
            },
            "description": "Energy type, e.g. Fire (see /types)"
          },
          {
            "name": "card_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Pokémon or Trainer",
              "title": "Card Type"
            },
            "description": "Pokémon or Trainer"
          },
          {
            "name": "set",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Set code, e.g. A1 (see /sets)",
              "title": "Set"
            },
            "description": "Set code, e.g. A1 (see /sets)"
          },
          {
            "name": "stage",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Basic, Stage 1, Stage 2, Item, Supporter, Tool, Stadium",
              "title": "Stage"
            },
            "description": "Basic, Stage 1, Stage 2, Item, Supporter, Tool, Stadium"
          },
          {
            "name": "rarity",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "e.g. ◊◊, ☆, ♛",
              "title": "Rarity"
            },
            "description": "e.g. ◊◊, ☆, ♛"
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Comma-separated fields to return, e.g. id,name,type,img",
              "title": "Fields"
            },
            "description": "Comma-separated fields to return, e.g. id,name,type,img"
