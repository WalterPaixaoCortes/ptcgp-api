    "/cards/ranking": {
      "get": {
        "summary": "Get Ranking",
        "description": "Pokémon ranked by their best attack (or HP).\n\nAttacks with zero cost or no damage are ignored. Ties: higher damage, then lower cost, then name.",
        "operationId": "get_ranking_cards_ranking_get",
        "parameters": [
          {
            "name": "metric",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "damage_per_energy",
                "damage",
                "hp"
              ],
              "type": "string",
              "default": "damage_per_energy",
              "title": "Metric"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 10,
              "title": "Limit"
            }
          },
          {
            "name": "distinct",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Count reprints (same name and attacks) once",
              "default": true,
              "title": "Distinct"
            },
            "description": "Count reprints (same name and attacks) once"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Energy type (see /types)",
              "title": "Type"
            },
            "description": "Energy type (see /types)"
          },
          {
            "name": "include_variable",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Include '+'/'x' attacks at their base damage",
              "default": true,
              "title": "Include Variable"
            },
            "description": "Include '+'/'x' attacks at their base damage"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ranking"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
