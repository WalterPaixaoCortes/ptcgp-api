            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "name, number, hp, type, retreat_cost or set; prefix '-' for descending",
              "title": "Sort"
            },
            "description": "name, number, hp, type, retreat_cost or set; prefix '-' for descending"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
